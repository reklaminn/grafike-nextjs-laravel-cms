<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- CI suite: bilinen eski (pre-existing) hatalı dosyalar dışlanır.
             Bu dosyalar tenant-DB kurulumu/legacy yapı sorunları taşıyor;
             düzeltildikçe exclude listesinden çıkarılmalı. -->
        <testsuite name="CI">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Admin/AdminAuthTest.php</exclude>
            <exclude>tests/Feature/Admin/ArticleManagementTest.php</exclude>
            <exclude>tests/Feature/Admin/DesignManagementTest.php</exclude>
            <exclude>tests/Feature/Admin/PageManagementTest.php</exclude>
            <exclude>tests/Feature/Admin/PageRevisionTest.php</exclude>
            <exclude>tests/Feature/Admin/SectionTemplateManagementTest.php</exclude>
            <exclude>tests/Feature/Admin/ThemeManagementTest.php</exclude>
            <exclude>tests/Feature/Api/ArticleApiTest.php</exclude>
            <exclude>tests/Feature/Api/PublicSiteApiTest.php</exclude>
            <exclude>tests/Feature/Console/MigratePageLayoutsToSectionsCommandTest.php</exclude>
            <exclude>tests/Feature/Console/SyncLegacyModulesToSectionTemplatesCommandTest.php</exclude>
            <exclude>tests/Feature/Frontend/FrontendPageTest.php</exclude>
            <exclude>tests/Feature/Frontend/MemberAuthTest.php</exclude>
            <exclude>tests/Feature/Frontend/RedirectTest.php</exclude>
            <exclude>tests/Unit/Models/ArticleTest.php</exclude>
            <exclude>tests/Unit/Models/LanguageTest.php</exclude>
            <exclude>tests/Unit/Models/PageTest.php</exclude>
            <exclude>tests/Unit/Models/SiteSettingTest.php</exclude>
            <exclude>tests/Unit/Services/Ai/AiPageGeneratorTest.php</exclude>
            <exclude>tests/Unit/Services/SeoManagerTest.php</exclude>
            <exclude>tests/Unit/Services/TemplateEngineTest.php</exclude>
            <exclude>tests/Unit/Support/LegacyLayoutToSectionsTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Prod'da default (mariadb) ve central AYNI fiziksel DB'dir.
             Testte de aynı olmaları için paylaşımlı sqlite memory kullan:
             file::memory:?cache=shared → iki bağlantı tek DB'yi görür.
             DB_DRIVER=sqlite central bağlantısını mariadb'den sqlite'a çevirir. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="file::memory:?cache=shared"/>
        <env name="DB_DRIVER" value="sqlite"/>
        <env name="DB_HOST" value=""/>
        <env name="DB_USERNAME" value=""/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
