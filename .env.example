APP_NAME="Grafike CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────
# Development (SQLite)
DB_CONNECTION=sqlite

# Production (MariaDB / MySQL) ─────────────────────
# DB_CONNECTION=mariadb
# DB_HOST=mariadb          # Docker service name, or 127.0.0.1 for bare-metal
# DB_PORT=3306
# DB_DATABASE=grafike_main  # Central (shared) database
# DB_USERNAME=grafike
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=root_secret   # Used by docker/mysql/init.sh to grant CREATE DB

# ─── Multi-Tenancy (stancl/tenancy) ───────────────
# Tenant databases are created automatically by stancl when you run:
#   php artisan tenants:migrate --tenants=<slug>
# Each tenant DB is named:  tenant_<slug>  (e.g. tenant_nuhcicek)
#
# CENTRAL_DOMAIN is the admin panel domain — requests to it bypass
# the tenant middleware and hit the central DB.
CENTRAL_DOMAIN=admin.grafike.app

# Prefix prepended to every tenant DB name.
TENANCY_DB_PREFIX=tenant_

# ─── Session & Cache ──────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=grafike_

# Redis (production recommended) ───────────────────
# CACHE_STORE=redis
# SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ─── Mail ──────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS / S3 Storage ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── CMS Configuration ────────────────────────────
CMS_FRONTEND_URL=http://127.0.0.1:3000
CMS_REVALIDATE_SECRET=change-me-in-production
FRONTEND_CONTAINER_NAME=grafike_cms_frontend
CMS_HOMEPAGE_ID=
CMS_CACHE_ENABLED=true
CMS_CACHE_TTL=600

# ─── Traefik dynamic config (tenant cert lifecycle) ───
# TraefikDynamicConfig writes per-tenant Host() routers here on every
# Domain CRUD; Traefik file provider hot-reloads them and ACME issues
# per-domain HTTP-01 certs.  Leave defaults unless your mount path differs.
# Set TRAEFIK_DYNAMIC_DISABLED=true to fully disable (e.g. local dev).
TRAEFIK_DYNAMIC_PATH=/var/traefik-dynamic
TRAEFIK_DYNAMIC_DISABLED=false
TRAEFIK_FRONTEND_SERVICE=grafike-frontend@docker
TRAEFIK_CERT_RESOLVER=mytlschallenge

# ─── Sentry ────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Octane (production) ───────────────────────────
OCTANE_SERVER=frankenphp
CMS_CDN_URL=
CMS_DEFAULT_LANGUAGE=tr

# ─── Google Services ──────────────────────────────
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=

# ─── reCAPTCHA ────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── AI Providers (FAZ 3 — AI abstraction layer) ──
# Default provider used when callers don't specify one.
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MAX_TOKENS=1024
AI_DEFAULT_TEMPERATURE=0.7
AI_TIMEOUT=60

# Fallback chain — when the primary provider returns a transient failure
# (429 / 5xx / timeout) the router walks down this list and retries.
# BYOK keys are NEVER carried into fallback providers (tenant safety).
AI_FALLBACK_ENABLED=true
AI_FALLBACK_CHAIN=anthropic,openai,openrouter
AI_FALLBACK_MAX_ATTEMPTS=3

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5
ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL_SIMPLE=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o

# OpenRouter (unified gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_SIMPLE=anthropic/claude-haiku-4-5
OPENROUTER_MODEL_COMPLEX=anthropic/claude-sonnet-4-6

# ─── Vite ─────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
